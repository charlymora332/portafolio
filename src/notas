header {
  background-color: #070b13;
  height: 4rem;
  width: 100vw;
  display: flex;

  justify-content: space-around;
  align-items: center;
  /* gap: 5rem; */
  padding: 0rem;
  margin: 0;
  position: fixed;
  z-index: 10;
  box-shadow: 0 2px 10px rgba(124, 109, 109, 0.5);
  /* Difuminado en el borde inferior */
  box-shadow: 0 2px 10px #2f394d;
  /* Difuminado en el borde inferior */



}


header a {
  color: rgba(255, 255, 255, 0.658);
  text-decoration: none;
  font-weight: 600;
  margin: 0 15px;
  position: relative;
  /* Necesario para los pseudo-elementos */
  transition: color 0.5s ease-in-out;
  display: inline-block;
  /* Necesario para que la transformación funcione correctamente */
  font-size: clamp(12px, 6.5Vh, 35px) !important;
}




header a:hover::before {
  transform: scaleX(1);
  transform-origin: left;
}

header a::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -2px;
  /* Ajustar según el tamaño del borde */
  width: 100%;
  height: 2px;
  /* Ajustar el grosor del borde */
  background-color: rgb(255, 255, 255);
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 0.5s ease-in-out;
}

header a:hover::before {
  transform: scaleX(1);
}

header a:hover {
  color: rgb(255, 255, 255);
}


