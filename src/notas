  grid-column-end: 2;

  grid-row-start: 1;

  grid-row-end: 1;
  margin: 0;
  padding: 0;

  border-radius: 34% 36% 70% 30% / 95% 75% 25% 25%;
  border-radius: 60% 40% 38% 62% / 75% 41% 39% 25%;
  border-radius: 75% 25% 75% 25% / 28% 25% 33% 25%;
  border-radius: 75% 25% 75% 25% / 54% 25% 60% 25%;



}


