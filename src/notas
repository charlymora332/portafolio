footer nav {
  width: 80%;
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  padding: 3rem 5rem 2rem 5rem;
  margin-top: 1rem;



}

footer nav::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 5px;
  /* Ajusta según la cantidad de difuminado */
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.3), transparent);
  /* Difuminado en la parte superior */
}



footer nav div {
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  height: 3rem;


  border-radius: 0.5rem;


  margin-top: 0;
  background-color: transparent;
  cursor: pointer;
  border: none;
  transition: linear 2ms;







  width: 100%;
  height: 100%;




}

footer nav div:hover {
  scale: 1.1;
  transform: scale(1.5);
  transition: transform 0.3s;
  /* Transición suave */

}


footer nav div a {
  height: 100%;
  width: 100%;

}

footer nav div a i {


  color: #FFFFFF;
  height: 100%;
  width: 100%;
  font-size: 1.5rem;




  padding: 0.5rem 1rem;






}


footer nav div i:hover {

  color: rgb(255, 255, 255);



}